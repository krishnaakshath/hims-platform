# HIMS settings for the Docker deployment: the single source for every
# variable the app reads. Copy to .env.docker (gitignored) and fill in:
#
#   cp .env.docker.example .env.docker
#
# Placeholders only; never commit real values, never reuse demo values in a
# real deployment. One deployment = one hospital: its own host, database,
# volumes and secrets. Changing a value: `docker compose up -d` (recreates the
# app with the new env). scripts/check-env-docs.ts fails CI when src/ reads a
# variable that is not listed here.

# ---------------------------------------------------------------------------
# Backing services (set by docker-compose.yml; listed here for reference)
# ---------------------------------------------------------------------------
# docker-compose.yml sets these for app/migrate/seed/codes and they override
# anything below. Postgres and Redis run in the stack; nothing is external.
# The password/token come from HIMS_DB_PASSWORD / HIMS_REDIS_TOKEN (see the
# header of docker-compose.yml).
# DATABASE_URL=postgres://postgres:hims_local_dev@postgres:5432/hims
# KV_REST_API_URL=http://redis-rest:8079
# KV_REST_API_TOKEN=hims_local_redis_token
# File store: the local-disk driver (the only one) writing to the hims_blobs
# volume. Any other BLOB_DRIVER value disables file storage (503s).
# BLOB_DRIVER=local
# BLOB_LOCAL_DIR=/app/data/blobs

# ---------------------------------------------------------------------------
# Secrets (required)
# ---------------------------------------------------------------------------
# Signs session cookies, 32+ characters:  openssl rand -base64 48
SESSION_SECRET=replace-me
# Exactly 32 bytes, base64; encrypts government ID numbers:  openssl rand -base64 32
# Losing or rotating it makes existing encrypted values unreadable: back it up.
IDENTITY_ENCRYPTION_KEY=replace-me
# 32 bytes, base64; at-rest key for integration payloads and ABHA flow state
# (separate from the identity key). Unset, ABHA routes answer 503:  openssl rand -base64 32
INTEGRATION_PAYLOAD_KEY=replace-me

# ---------------------------------------------------------------------------
# Public URL and the always-available admin account
# ---------------------------------------------------------------------------
# The URL users open (behind your reverse proxy: https://hims.example.org).
NEXT_PUBLIC_APP_URL=http://localhost:3001
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
# salt:hash from src/lib/password.ts hashPassword() (README has the one-liner)
ADMIN_PASSWORD_HASH=replace-me

# ---------------------------------------------------------------------------
# Branding (optional). Read when the app starts; prerendered pages keep the
# values from the last image build, so rebuild after changing them:
#   docker compose build app && docker compose up -d
# ---------------------------------------------------------------------------
# Product name in UI, emails, SMS, MFA app. Default: HIMS
BRAND_NAME=
# Legal/entity name for printed documents. Default: BRAND_NAME
BRAND_LEGAL_NAME=
# Short description for page metadata
BRAND_TAGLINE=
# Support contact address
BRAND_SUPPORT_EMAIL=
# Same-origin /path (or an https:// URL you host). Default: name as text
BRAND_LOGO_URL=
# #rgb or #rrggbb accent colour
BRAND_PRIMARY_COLOR=
# [a-z0-9_]{1,24}. Default: hims. Changing it logs everyone out.
BRAND_COOKIE_PREFIX=
# Line on the sign-in screen (max 200 chars) and who said it (max 100; empty = the hospital's own line).
# Default: a Florence Nightingale quote on patient safety.
BRAND_LOGIN_QUOTE=
BRAND_LOGIN_QUOTE_ATTRIBUTION=

# ---------------------------------------------------------------------------
# Feature switches
# ---------------------------------------------------------------------------
# Clinical-trials area (Workbook, Trials, Pipeline). "true" or "1" enables it.
ENABLE_TRIALS=false
# Cash Desk UPI QR: the hospital's UPI id (e.g. hospital@icici). Unset, UPI is
# recorded by typed reference and the QR request answers 503.
HOSPITAL_UPI_VPA=
# Payee name shown in the payer's UPI app (default "Hospital")
HOSPITAL_UPI_PAYEE=

# ---------------------------------------------------------------------------
# Demo / evaluation switches. Leave all of these empty on a real deployment.
# ---------------------------------------------------------------------------
# Simulated features (virtual card payments, simulated broadcasts, ...): true | false
DEMO_FEATURES=
# "true" skips the staff TOTP step at login (only while DEMO_FEATURES is on)
DISABLE_STAFF_MFA=
# Sandbox ABDM / NHCX mocks: 1 or true. The image runs with NODE_ENV=production,
# so they also need DEMO_FEATURES set on AND ALLOW_DEMO_MOCKS=true.
ABDM_USE_MOCKS=
ALLOW_DEMO_MOCKS=

# ---------------------------------------------------------------------------
# Container start-up (scripts/docker-entrypoint.sh, scripts/docker/prestart.ts)
# ---------------------------------------------------------------------------
# Migrations run automatically on every start (idempotent). "1" skips them.
SKIP_MIGRATIONS=
# Database connection attempts, 2 s apart, before start-up gives up (default 60)
DB_WAIT_ATTEMPTS=

# ---------------------------------------------------------------------------
# Demo seed (docker compose --profile seed run --rm seed, or SEED_ON_START)
# ---------------------------------------------------------------------------
# The container runs with NODE_ENV=production: the seed refuses unless this is 1.
# Set it only on a demo/evaluation stack.
ALLOW_PRODUCTION_SEED=
# "true": seed on container start when the database has no patients and no users.
SEED_ON_START=
# Required for seeding: 12+ characters, shared by all demo staff accounts. No default.
SEED_DEMO_PASSWORD=replace-me
# Domain of the demo staff accounts (admin@, crc@, pi@, frontdesk@, pharmacy@,
# billing@, labs@, pathologist@, collector@, coder@). Default: example.test
SEED_EMAIL_DOMAIN=example.com
# "1" clears the existing demo data and rebuilds it. Unset: top up reference data only.
SEED_RESET=

# ===========================================================================
# Optional integrations. All OFF by default (empty). These are the only
# features that call third-party hosts at run time, and only once configured.
# ===========================================================================

# --- Email one-time codes and notifications (your SMTP server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS (Twilio, api.twilio.com): one-time codes and notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# India DLT: registered sender header, and a JSON map {"<templateKey>":"<DLT template id>"}
SMS_DLT_SENDER_ID=
SMS_DLT_TEMPLATE_IDS=

# --- WhatsApp Cloud API (graph.facebook.com) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# JSON map {"<templateKey>":"<approved template name>"}; language code (default en)
WHATSAPP_TEMPLATE_NAMES=
WHATSAPP_TEMPLATE_LANGUAGE=

# --- Google SSO for the admin account (accounts.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Inbound lab system webhook (/api/webhooks/fhir-labs). Unset = disabled. ---
LIS_INTEGRATION_TOKEN=

# --- Scheduler secret for /api/cron/nhcx-sweep (call it from host cron) ---
CRON_SECRET=

# --- ABDM / NHCX (see docs/ABDM-NHCX.md). PEM keys/certs are one-line base64. ---
# sandbox https://dev.abdm.gov.in; production https://apis.abdm.gov.in
ABDM_GATEWAY_BASE_URL=
# sandbox https://abhasbx.abdm.gov.in
ABHA_BASE_URL=
# sandbox: sbx
ABDM_CM_ID=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# HFR ID of the facility (Scan & Share X-HIP-ID)
ABDM_HIP_ID=
# Key set for ABDM callback JWTs (confirm the URL with NHA at onboarding)
ABDM_GATEWAY_JWKS_URL=
# Path INSIDE the container to the verbatim NHA ABHA enrolment consent text.
# Mount it read-only (e.g. a compose override volume ./abdm:/app/docs/abdm:ro).
# Default docs/abdm/abha-enrolment-consent-1.4.txt (relative to /app).
ABDM_CONSENT_TEXT_PATH=
# sandbox https://apisbx.abdm.gov.in/hcx
NHCX_API_BASE_URL=
NHCX_PARTICIPANT_SERVICE_URL=
NHCX_PARTICIPANT_CODE=
NHCX_ENCRYPTION_PRIVATE_KEY=
NHCX_PREVIOUS_ENCRYPTION_PRIVATE_KEY=
NHCX_ENCRYPTION_CERT=
NHCX_GATEWAY_SIGNING_CERT=
# Comma-separated IPv4 addresses NHCX callbacks come from
NHCX_CALLBACK_IP_ALLOWLIST=
# Total attachment bytes per NHCX message (default 10000000)
NHCX_MAX_ATTACHMENT_BYTES=
# "1" lets the sweep and RCM ask NHCX for status. Default off.
NHCX_STATUS_POLLING=
