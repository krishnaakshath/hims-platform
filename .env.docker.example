# Template for .env.docker (Docker Compose secrets for local/demo HIMS).
# Copy to .env.docker and fill in. .env.docker is gitignored; this file holds
# placeholders only. Never reuse demo values in a real deployment.
# DATABASE_URL / KV_REST_API_URL / KV_REST_API_TOKEN come from docker-compose.yml.

# Session cookie signing secret: openssl rand -base64 48
SESSION_SECRET=replace-me
# 32 bytes, base64, identity-field encryption: openssl rand -base64 32
IDENTITY_ENCRYPTION_KEY=replace-me
# 32 bytes, base64, at-rest key for integration payloads and ABHA flow state
# (separate from the identity key). Without it ABHA routes answer 503
# "Integration encryption key is not set": openssl rand -base64 32
INTEGRATION_PAYLOAD_KEY=replace-me

NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
# bcrypt hash of the admin password
ADMIN_PASSWORD_HASH=replace-me

# Demo switches. Never set these in a real deployment.
# Simulated features (virtual card payments, simulated broadcasts, ...): true | false
DEMO_FEATURES=true
# Skips the staff TOTP step at login (only effective while DEMO_FEATURES is on)
DISABLE_STAFF_MFA=true
# Sandbox ABDM / NHCX mocks: 1 or true. In a production build they also need
# DEMO_FEATURES set explicitly on AND ALLOW_DEMO_MOCKS=true.
ABDM_USE_MOCKS=true
ALLOW_DEMO_MOCKS=true
EHR_USE_MOCKS=1

# Blob storage: local disk driver for the Docker stack
BLOB_DRIVER=local
# Show the clinical-trials module (off by default)
ENABLE_TRIALS=false

SEED_EMAIL_DOMAIN=example.com
SEED_DEMO_PASSWORD=replace-me
