{
  "name": "hims-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200 app",
    "docker:ps": "docker compose ps",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:migrate:status": "docker compose run --rm migrate migrate --status",
    "docker:seed": "docker compose --profile seed run --rm seed",
    "docker:codes": "docker compose --profile codes run --rm codes",
    "docker:test": "docker compose --profile test run --rm test",
    "docker:psql": "docker compose exec postgres psql -U postgres -d hims",
    "docker:backup": "mkdir -p backups && docker compose exec -T postgres pg_dump -U postgres -d hims --format=custom --no-owner --no-privileges > backups/hims-$(date -u +%Y%m%dT%H%M%SZ).dump",
    "test": "vitest run",
    "check:env-docs": "tsx scripts/check-env-docs.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:status": "tsx scripts/db/migrate.ts --status",
    "db:schema-diff": "tsx scripts/db/schema-diff.ts",
    "db:backup": "tsx scripts/db/backup.ts",
    "db:restore-check": "tsx scripts/db/restore-check.ts",
    "db:seed": "tsx src/db/seed.ts",
    "codes:fetch-who": "tsx scripts/code-systems/fetch-who-icd10.ts",
    "codes:import": "tsx scripts/import-code-system.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@testing-library/dom": "^10.4.2",
    "@types/pg": "^8.23.1",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "geist": "1.7.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "^16.4.3",
    "nodemailer": "^10.0.10",
    "ogl": "^1.0.11",
    "otpauth": "^9.5.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "shadcn": "^4.21.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
