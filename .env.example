# Copy to .env.local for local development, or set these in the Vercel project
# (Settings > Environment Variables). Never commit real values. One deployment
# = one client: every client gets its own database, Redis, Blob store and secrets.

# --- Branding (all optional; read at BUILD time -- changing any requires a rebuild/redeploy) ---
# Product name shown in UI, emails, SMS, MFA app. Default: HIMS
BRAND_NAME=
# Legal/entity name for printed documents. Default: BRAND_NAME
BRAND_LEGAL_NAME=
# Short description for page metadata
BRAND_TAGLINE=
# Support contact address
BRAND_SUPPORT_EMAIL=
# https:// URL or same-origin /path. Default: name as text
BRAND_LOGO_URL=
# #rgb or #rrggbb accent colour
BRAND_PRIMARY_COLOR=
# [a-z0-9_]{1,24}. Default: hims. Changing it logs everyone out.
BRAND_COOKIE_PREFIX=

# --- Core (required) ---
# Postgres connection string (Neon or any Postgres with TLS).
DATABASE_URL=
# 32+ random characters; signs all session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=
# Exactly 32 bytes, base64-encoded; encrypts government ID numbers. Generate: openssl rand -base64 32
# Losing or rotating this makes existing encrypted values unreadable.
IDENTITY_ENCRYPTION_KEY=
# Public https URL of this deployment (used for Google SSO redirects).
NEXT_PUBLIC_APP_URL=

# --- Always-available admin account (staff login) ---
ADMIN_EMAIL=
ADMIN_NAME=Admin
# salt:hash pair from src/lib/password.ts hashPassword() (see README for a one-liner)
ADMIN_PASSWORD_HASH=

# --- Redis (rate limits, MFA replay tracking, cache) ---
# Provisioned automatically by Vercel's Upstash Redis integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- File storage ---
# Vercel Blob read/write token (set automatically when a Blob store is connected to the project).
BLOB_READ_WRITE_TOKEN=

# --- Email one-time codes (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS one-time codes (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional integrations ---
# Google SSO for the admin account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bearer token the lab system presents to /api/webhooks/fhir-labs. Unset = webhook disabled.
LIS_INTEGRATION_TOKEN=

# --- Demo/evaluation only (never set in production) ---
# Skips staff MFA when "true". Leave unset for any deployment with real data.
DISABLE_STAFF_MFA=

# --- Demo seed (npm run db:seed) ---
# The seed refuses to run when NODE_ENV or VERCEL_ENV is "production" unless ALLOW_PRODUCTION_SEED=1.
# Domain for demo staff accounts (admin@, crc@, pi@, frontdesk@, pharmacy@, billing@, labs@). Default: example.test
SEED_EMAIL_DOMAIN=
# Required for seeding, 12+ characters, shared by all demo staff accounts. No default.
SEED_DEMO_PASSWORD=
ALLOW_PRODUCTION_SEED=
